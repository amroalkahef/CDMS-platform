# Copy to secret.yaml, fill in real values, and DO NOT commit it.
# kubectl apply -f k8s/secret.yaml  (or manage via your cluster's secret
# store / sealed-secrets / external-secrets operator in production).
apiVersion: v1
kind: Secret
metadata:
  name: platform-secrets
  namespace: cdms-platform
type: Opaque
stringData:
  LLM_API_KEY: "sk-..."
  POSTGRES_PASSWORD: "change-me"
  DATABASE_URL: "postgresql+psycopg2://platform:change-me@postgres:5432/platform"
