{
  "title": "AI Platform — Agents & Requests",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Agent calls / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(ai_agent_calls_total[5m])) by (agent)", "legendFormat": "{{agent}}" }]
    },
    {
      "id": 2,
      "title": "Agent errors / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(ai_agent_errors_total[5m])) by (agent)", "legendFormat": "{{agent}}" }]
    },
    {
      "id": 3,
      "title": "Agent duration p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_agent_duration_ms_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tokens consumed / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(ai_agent_tokens_total[5m])) by (agent)", "legendFormat": "{{agent}}" }]
    },
    {
      "id": 5,
      "title": "HTTP requests / min (ai-platform + backend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (job, handler)", "legendFormat": "{{job}} {{handler}}" }]
    }
  ]
}
